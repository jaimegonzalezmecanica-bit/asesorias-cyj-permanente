{
  "buildCommand": "npm run db:generate && npm run db:push && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["sfo1"],
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string from Neon.tech",
      "required": true
    },
    "DIRECT_URL": {
      "description": "Direct PostgreSQL connection URL for Prisma migrations",
      "required": true
    },
    "NEXTAUTH_SECRET": {
      "description": "Secret key for NextAuth.js authentication",
      "required": true
    },
    "NEXTAUTH_URL": {
      "description": "URL of the deployed application",
      "required": true
    },
    "NODE_ENV": {
      "value": "production",
      "required": false
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
